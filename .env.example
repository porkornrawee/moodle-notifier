# ---------- Moodle ----------
MOODLE_URL=https://courses.cs.tu.ac.th
MOODLE_USER=your_moodle_username
# ทางเลือก A: ใส่ตรงนี้เลย (ไฟล์นี้ถูก .gitignore ไว้แล้ว)
MOODLE_PASS=your_moodle_password
# ทางเลือก B (ปลอดภัยกว่า): ลบบรรทัด MOODLE_PASS ทิ้ง แล้วเก็บใน Keychain
#   security add-generic-password -s moodle-watch -a your_moodle_username -w
KEYCHAIN_SERVICE=moodle-watch

# รหัสคอร์สที่จะเฝ้า (ดูจาก .../course/view.php?id=XXX) คั่นด้วย ,
COURSE_IDS=914

# ---------- ช่องทางแจ้งเตือน (เปิดอย่างน้อย 1 อย่าง) ----------
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Telegram: ทัก @BotFather -> /newbot ได้ token, แล้วทักบอทเรา 1 ครั้ง
#           จากนั้นเปิด https://api.telegram.org/bot<TOKEN>/getUpdates เพื่อดู chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# แจ้งเตือนเด้งบนหน้าจอ Mac (ใช้ได้เฉพาะตอนรันบนเครื่องตัวเอง)
NOTIFY_MACOS=1

# ---------- อื่น ๆ ----------
# เตือนล่วงหน้าก่อนถึงกำหนดส่ง (ชั่วโมง)
DUE_ALERT_HOURS=72,24,6
HTTP_TIMEOUT=30
